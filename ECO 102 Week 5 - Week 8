function setupMatches(){
 let pairs=DATA.matches.map((p,i)=>({id:i,left:p[0],right:p[1]}));
 let items=[...pairs.map(p=>({id:p.id,side:'l',text:p.left})),...pairs.map(p=>({id:p.id,side:'r',text:p.right}))].sort(()=>Math.random()-.5);
 let chosen=null,matched=new Set(),locked=false;
 $('matchArea').innerHTML=items.map((x,i)=>`<button class="match" data-id="${x.id}" data-side="${x.side}" data-key="${i}">${x.text}</button>`).join('');
 $('matchScore').textContent='0 / 16';$('matchFeedback').textContent='Choose a term, then its definition. Correct pairs turn green; incorrect choices shake.';
 document.querySelectorAll('.match').forEach(b=>b.onclick=()=>{
  if(locked||b.classList.contains('done'))return;
  let item=items[Number(b.dataset.key)];
  if(!chosen){chosen=item;b.classList.add('selected');return}
  if(chosen.id===item.id&&chosen.side!==item.side){
   matched.add(item.id);
   document.querySelectorAll(`.match[data-id="${item.id}"]`).forEach(x=>{x.classList.remove('selected');x.classList.add('done','pop')});
   $('matchFeedback').textContent='✓ Correct match! Both cards are now marked green.';
   $('matchScore').textContent=matched.size+' / 16';
   if(matched.size===16)$('matchFeedback').textContent='🏆 Excellent — all sixteen pairs matched!';
   chosen=null;return;
  }
  if(chosen===item){b.classList.remove('selected');chosen=null;return}
  let first=document.querySelector(`.match[data-id="${chosen.id}"][data-side="${chosen.side}"]`);
  locked=true;b.classList.add('selected');
  [first,b].forEach(x=>{if(x){x.classList.remove('selected');x.classList.add('shake')}});
  $('matchFeedback').textContent='✕ Not a match. The cards will shake — try a different pairing.';
  setTimeout(()=>{[first,b].forEach(x=>{if(x)x.classList.remove('shake','selected')});chosen=null;locked=false;},480);
 });
}
$('resetMatch').onclick=setupMatches;setupMatches();
