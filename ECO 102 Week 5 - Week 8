function renderSummaries(){let term=$('search').value.toLowerCase(),wf=$('weekFilter').value;let arr=DATA.weeks.filter(w=>(wf==='all'||String(w.week)===wf)&&JSON.stringify(w).toLowerCase().includes(term));$('summaryList').innerHTML=arr.map(w=>`<article class="card searchable"><span class="tag">WEEK ${w.week}</span><h3>${w.title}</h3><p>${w.summary}</p>${w.sections.map(s=>`<h4>${s[0]}</h4><p>${s[1]}</p>`).join('')}<div class="callout warning"><b>Worked Examples & Exam Traps</b><ul>${w.examTraps.map(t=>`<li>${t}</li>`).join('')}</ul></div><div class="callout"><b>Exam takeaways</b><ul>${w.takeaways.map(t=>`<li>${t}</li>`).join('')}</ul></div></article>`).join('')||'<p class="muted">No matching topics found.</p>'}
