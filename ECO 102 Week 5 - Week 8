let active=[],missed=[],idx=0,correct=0,done=0;
function beginQuiz(list){active=list;missed=[];idx=0;correct=0;done=0;$('score').textContent='0';$('answered').textContent='0';$('total').textContent=list.length;updateProgress();renderQuestion()}
function updateProgress(){$('progress').style.width=(active.length?done/active.length*100:0)+'%'}
function renderQuestion(){
 if(!active.length){$('quizArea').innerHTML='<p class="muted">No questions available for this selection.</p>';return}
 $('quizArea').innerHTML=`<div class="eyebrow">All ${active.length} questions · Answer in any order</div><div id="quizCompletion" class="callout">Select an answer under each question. Your feedback and score update immediately.</div><div id="allQuestions"></div><div id="quizEnd" class="callout" style="display:none"></div>`;
 $('allQuestions').innerHTML=active.map((q,qi)=>`<div class="quiz-question" data-question="${qi}"><div class="eyebrow">Question ${qi+1} · Week ${q.week}</div><div class="qtitle">${q.q}</div>${q.opts.map((o,i)=>`<button class="option" data-question="${qi}" data-i="${i}">${String.fromCharCode(65+i)}. ${o}</button>`).join('')}<div class="feedback" id="qfeedback${qi}"></div></div>`).join('');
 document.querySelectorAll('#allQuestions .option').forEach(b=>b.onclick=()=>answer(Number(b.dataset.question),Number(b.dataset.i)));
}
function answer(qi,n){
 let q=active[qi],wrap=document.querySelector(`[data-question="${qi}"]`);
 if(!wrap||wrap.dataset.answered==='yes')return;
 wrap.dataset.answered='yes';
 wrap.querySelectorAll('.option').forEach((b,i)=>{b.disabled=true;if(i===q.a)b.classList.add('correct');if(i===n&&n!==q.a)b.classList.add('wrong')});
 let ok=n===q.a;if(ok)correct++;else missed.push(q);done++;
 $('score').textContent=correct;$('answered').textContent=done;updateProgress();
 let fb=$('qfeedback'+qi);fb.className='quiz-feedback '+(ok?'good':'bad');fb.textContent=(ok?'✓ Correct — ':'✕ Not quite — ')+q.why;
 $('quizCompletion').textContent=`${done} of ${active.length} answered · ${correct} correct · ${missed.length} to review`;
 if(done===active.length){let end=$('quizEnd');end.style.display='block';end.innerHTML=`<b>Quiz complete: ${correct} / ${active.length}</b><br>${missed.length} question(s) to review. ${missed.length?'Use "Retry missed" above to practise them again.':'Excellent work — you got every question right!'}`;}
}
